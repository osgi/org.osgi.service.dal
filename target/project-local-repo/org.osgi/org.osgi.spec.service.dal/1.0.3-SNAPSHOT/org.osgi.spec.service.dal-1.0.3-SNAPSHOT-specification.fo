                                 <fo:block>unit</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The unit to align the metadata if it's applicable. It can be
        null, which means that the default unit will be used.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
