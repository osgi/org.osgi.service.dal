                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e438">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.SERVICE_FIRMWARE_VERSION">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_FIRMWARE_VERSION</fo:inline>
                                 </fo:basic-link> – Specifies the device firmware version.
            It's an optional property. The value type is
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">java.lang.String</fo:inline>.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e444">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.SERVICE_TYPES">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_TYPES</fo:inline>
                                 </fo:basic-link> – Specifies the device types. It's an
            optional property. The value type is
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">java.lang.String[]</fo:inline>.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e451">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.SERVICE_MODEL">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_MODEL</fo:inline>
                                 </fo:basic-link> – Specifies the device model. It's an
            optional property. The value type is
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">java.lang.String</fo:inline>.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e457">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.SERVICE_SERIAL_NUMBER">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_SERIAL_NUMBER</fo:inline>
                                 </fo:basic-link> – Specifies the device serial number. It's
            an optional property. The value type is
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">java.lang.String</fo:inline>.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The next code snippet prints all online devices. <fo:block space-before.minimum="0.8em"
                            space-before.optimum="1em"
                            space-before.maximum="1.2em"
                            space-after.minimum="0.8em"
                            space-after.optimum="1em"
                            space-after.maximum="1.2em"
                            hyphenate="false"
                            wrap-option="no-wrap"
                            white-space-collapse="false"
                            white-space-treatment="preserve"
                            linefeed-treatment="preserve"
                            text-align="start"
                            font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                            font-size="9pt"
                            letter-spacing="-.0em"
                            space-before="5pt"
                            space-after="3pt"
                            space-after.conditionality="retain"
                            start-indent="inherit"
                            line-height="11pt"
                            id="d609e465">ServiceReference[] deviceSRefs = context.getServiceReferences(
    Device.class.getName(),
    '(' + Device.SERVICE_STATUS + '=' + Device.STATUS_ONLINE + ')');
if (deviceSRefs != null) {
    for (int i = 0; i &lt; deviceSRefs.length; i++) {
        printDevice(deviceSRefs[i]);
    }
}</fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Applications need to have an access to the device properties. For
      convenience, there are helper methods: <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d609e468">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e469">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.getServiceProperty-String-">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getServiceProperty(String)</fo:inline>
                                 </fo:basic-link> – Returns the current value of the
            specified property. The method will return the same value as
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">org.osgi.framework.ServiceReference.getProperty(String)</fo:inline>
            for the service reference of this device.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e475">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.getServicePropertyKeys--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getServicePropertyKeys()</fo:inline>
                                 </fo:basic-link> – Returns an array with all device service
            property keys. The method will return the same value as
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">org.osgi.framework.ServiceReference.getPropertyKeys()</fo:inline>
            for the service reference of this device.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
            </fo:block>
            <fo:block id="service.dal-device.registration">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>141.3.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Device Registration</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The devices are registered as services in the OSGi service
      registry. The service interface is
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.dal.Device</fo:inline>. There is a registration order.
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Device</fo:inline>
                  </fo:basic-link>
      services are registered last on start up. Before their registration,
      there is <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Function">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Function</fo:inline>
                  </fo:basic-link> service registration. The function registration
      procedure is described in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="service.dal-function.registration">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Function Registration</fo:inline> on page <fo:page-number-citation ref-id="service.dal-function.registration"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The OSGi service registry provides an access to the services, but
      there are no management operations like remove a given service. The
      service provider is responsible to register and unregister own services.
      That design doesn't provide an option to remove the device services. The
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Device</fo:inline>
                  </fo:basic-link>
      interface fills this gap with <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device.remove--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">remove()</fo:inline>
                  </fo:basic-link>
      method. It's a callback to the service provider to remove the device
      from the network. The method can be optionally implemented.
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">java.lang.UnsupportedOperationException</fo:inline> can be thrown if
      the method is not supported. When the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device.remove--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">remove()</fo:inline>
                  </fo:basic-link>
      is called: <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d609e503">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e504">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>An appropriate command will be synchronously send to the
            device. As a result it can leave the network.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e506">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>The device status will be set to <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.dal.Device.STATUS_REMOVED">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">STATUS_REMOVED</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d609e511">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>The related device service will be unregistered from the
            OSGi service registry.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block> There is an unregistration order. The registration
      reverse order is used when the services are unregistered. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Device</fo:inline>
                  </fo:basic-link> services
      are unregistered first before <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Function">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Function</fo:inline>
                  </fo:basic-link>
      services.</fo:block>
            </fo:block>
            <fo:block id="d609e519">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>141.3.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Reference Devices</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Device</fo:inline>
                  </fo:basic-link> service can have a reference to other devices.
      That link can be used to represent different relationships between
      devices. For example, the EnOcean dongle can be used as USB Device and
      EnOcean network controller <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">Device</fo:inline>
                  </fo:basic-link>. The network controller device can have a
      reference to the physical USB device as it's depicted on the next
      diagram.</fo:block>
               <fo:block start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="d609e526">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 141.2</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Device Reference</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d609e528" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.dal/spec/org.osgi.spec.service.dal/src/main/resources/spec/service.dal.device.reference.svg)"
                                             width="15%"
                                             height="auto"
                                             content-width="scale-to-fit"
                                             content-height="scale-to-fit"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The related service property is <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device.SERVICE_REFERENCE_UIDS">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">SERVICE_REFERENCE_UIDS</fo:inline>
                  </fo:basic-link>.</fo:block>
            </fo:block>
            <fo:block id="service.dal-status.transitions">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>141.3.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Device Status Transitions</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The device status reveals the device availability. It can
      demonstrate that device is currently not available for operations or
      that the device requires some additional configuration steps. The status
      can move between the different values according to the rules defined in
      this section. The status transitions are summarized in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="service.dal-table.device.status.transitions">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Table 141.2</fo:inline>
                  </fo:basic-link>, visualized on
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="service.dal-figure.device.status.transitions">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 141.3</fo:inline>
                  </fo:basic-link> and
      described in detail in the next sections. The initial device status is
      always <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device.STATUS_PROCESSING">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">STATUS_PROCESSING</fo:inline>
                  </fo:basic-link>. When device info is processed, the device can
      go to another status. The last possible device status is <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.dal.Device.STATUS_REMOVED">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">STATUS_REMOVED</fo:inline>
                  </fo:basic-link>. The status must be set when the device is
      removed from the network. After that status, the device service will be
      unregistered.</fo:block>
               <fo:block start-indent="0pt">
