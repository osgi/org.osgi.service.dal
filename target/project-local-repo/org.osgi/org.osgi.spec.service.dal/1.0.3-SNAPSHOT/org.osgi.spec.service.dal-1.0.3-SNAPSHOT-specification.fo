                                          <fo:block>141.6.6</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract class FunctionData<fo:block line-height="0pt"/> implements Comparable&lt;Object&gt;</fo:block>
