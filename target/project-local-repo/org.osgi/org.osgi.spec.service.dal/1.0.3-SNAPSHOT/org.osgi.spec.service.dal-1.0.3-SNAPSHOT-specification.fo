                                 </fo:list-item>
                              </fo:list-block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">Custom status details are allowed, but they must not overlap
            the specified codes. To prevent possible collisions with further
            updates, custom codes must be greater than <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">100</fo:inline> and
            less than <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">-100</fo:inline>. <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="service.dal-table.status.detail.mapping">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">Table 141.1</fo:inline>
                                 </fo:basic-link> contains the
            mapping of the status details to the statuses.</fo:block>
